    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
