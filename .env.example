# ============================================================
# KAIDO E-commerce — biến môi trường mẫu
# Sao chép thành .env.local và điền giá trị. KHÔNG commit .env.local.
# Không dùng tiền tố NEXT_PUBLIC_ cho khóa bí mật.
# ============================================================

# --- Site công khai ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Supabase (chỉ dùng phía server) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kaido-media

# --- JWT & mật khẩu ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_ROUNDS=12

# --- Cron (Vercel Cron gửi Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=

# --- Cổng thanh toán ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=

# --- Đơn vị vận chuyển ---
GHN_TOKEN=
GHN_SHOP_ID=
GHN_API_URL=
GHTK_TOKEN=
GHTK_API_URL=
VIETTELPOST_API_URL=
CARRIER_WEBHOOK_SECRET=

# --- Email (hàng đợi thông báo) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cache tùy chọn (khuyến nghị cho rate limit trên Vercel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
