# ============================================================
# KAIDO E-commerce — biến môi trường mẫu
# Sao chép thành .env.local và điền giá trị. KHÔNG commit .env.local.
# Không dùng tiền tố NEXT_PUBLIC_ cho khóa bí mật.
# ============================================================

# --- Site công khai ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Supabase (chỉ dùng phía server) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kaido-media

# --- JWT & mật khẩu ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
BCRYPT_ROUNDS=12

# --- Cron (Vercel Cron gửi Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=

# --- Cổng thanh toán ---
# Cổng chỉ được coi là đã cấu hình khi đủ khóa bắt buộc:
#   VNPAY   -> VNPAY_TMN_CODE + VNPAY_HASH_SECRET
#   MOMO    -> MOMO_PARTNER_CODE + MOMO_ACCESS_KEY + MOMO_SECRET_KEY
#   ZALOPAY -> ZALOPAY_APP_ID + ZALOPAY_KEY1 + ZALOPAY_KEY2
# Thiếu khóa thì phương thức tương ứng tự ẩn (COD vẫn dùng được).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
# Cho phép chế độ mô phỏng thanh toán trên production (chỉ bật tạm khi demo, tắt ngay sau đó).
PAYMENT_SANDBOX_DEMO=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
# Sandbox công khai của ZaloPay: app_id 554 + cặp key công bố tại https://docs.zalopay.vn/docs/specs/order-create/
# Redirect mặc định: <NEXT_PUBLIC_SITE_URL>/payment/zalopay-return
# Callback mặc định: <NEXT_PUBLIC_SITE_URL>/api/v1/payments/zalopay/callback
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
# Chuyển khoản ngân hàng (VietQR): cần đủ BIN + số tài khoản + tên chủ tài khoản.
# BIN tra cứu tại https://api.vietqr.io/v2/banks (ví dụ Vietcombank 970436, MB 970422).
# Thiếu BANK_TRANSFER_WEBHOOK_SECRET thì chỉ xác nhận tay ở /admin/orders/[id].
BANK_TRANSFER_BANK_BIN=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NO=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_WEBHOOK_SECRET=
# Hạn giữ tồn cho đơn chuyển khoản (phút, mặc định 60).
BANK_TRANSFER_TIMEOUT_MINUTES=60

# --- Đơn vị vận chuyển ---
GHN_TOKEN=
GHN_SHOP_ID=
GHN_API_URL=
GHTK_TOKEN=
GHTK_API_URL=
VIETTELPOST_API_URL=
CARRIER_WEBHOOK_SECRET=

# --- Email (hàng đợi thông báo) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Cache tùy chọn (khuyến nghị cho rate limit trên Vercel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
